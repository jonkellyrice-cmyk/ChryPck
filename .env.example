# Fine-grained GitHub token. Its repository permissions remain the ultimate access boundary.
GITHUB_TOKEN=github_pat_replace_me

# Use * to allow any repository the configured GitHub token can access.
# Alternatively, provide a comma-separated exact allowlist such as owner/repo,owner/other-repo.
ALLOWED_REPOSITORIES=*

# Explicit mutable branch used when chrypck_plan does not provide base_ref.
CHRYPCK_DEFAULT_TARGET_REF=main

# GitHub REST API version.
GITHUB_API_VERSION=2026-03-10

# Immutable snapshot / mutation bounds.
CHRYPCK_MAX_TEXT_FILE_BYTES=524288
CHRYPCK_MAX_REPOSITORY_FILES=12000
CHRYPCK_MAX_MUTATION_FILE_BYTES=1048576

# Server binding. ChatGPT must reach this endpoint over HTTPS in deployment.
HOST=127.0.0.1
PORT=3000

# Optional inbound HTTP restrictions.
# MCP_PUBLIC_HOST=chrypck.example.com
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
# MCP_BEARER_TOKEN=replace_with_a_long_random_secret
