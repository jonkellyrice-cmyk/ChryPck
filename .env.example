# GitHub credential. Prefer a fine-grained token restricted to governed repos.
GITHUB_TOKEN=github_pat_replace_me

# Comma-separated repository allowlist. Small MCP refuses every other repo.
ALLOWED_REPOSITORIES=jonkellyrice-cmyk/Lancer-Frame-Conn

# Repository-owned toolchain entrypoint. This is the ONLY path Small MCP writes.
TOOLCHAIN_REQUEST_PATH=dev_scripts/github-filepatcher.json

# Canonical workflow and status contexts used to derive execution state/evidence.
TOOLCHAIN_WORKFLOW_NAME=GitHub FilePatcher
TOOLCHAIN_REQUIRED_STATUS_CONTEXTS=frame-conn/orchestrator,frame-conn/telemetry/github-filepatcher

# GitHub REST API version.
GITHUB_API_VERSION=2026-03-10

# Server binding. Use a deployment platform or secure tunnel for ChatGPT.
HOST=127.0.0.1
PORT=3000

# Optional inbound HTTP restrictions for deployment.
# MCP_PUBLIC_HOST=small-mcp.example.com
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
# MCP_BEARER_TOKEN=replace_with_a_long_random_secret

# Server-side source grants are short-lived and must be re-derived from toolchain evidence.
GRANT_TTL_SECONDS=3600

# Hard response/input bounds.
MAX_GRANTED_FILE_BYTES=524288
MAX_JOB_LOG_CHARACTERS=2000000
